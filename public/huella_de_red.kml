<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Huella de Red American Data Networks</name>
    <description>Polígonos oficiales de cobertura FTTH en la Gran Área Metropolitana (GAM) de Costa Rica.</description>

    <!-- Huella Alajuela Centro - Sector A03 (Borde exacto a 94m del punto 10.018194, -84.216833) -->
    <Placemark>
      <name>Huella FTTH Alajuela - A03</name>
      <description>Cobertura activa de fibra óptica red troncal A03 Alajuela Centro</description>
      <Style>
        <LineStyle>
          <color>ffffd400</color>
          <width>2.5</width>
        </LineStyle>
        <PolyStyle>
          <color>40ffd400</color>
        </PolyStyle>
      </Style>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -84.215976,10.019500,0
              -84.215976,10.016500,0
              -84.214000,10.016000,0
              -84.213200,10.018500,0
              -84.214500,10.020200,0
              -84.215976,10.019500,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

